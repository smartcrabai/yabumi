#!/usr/bin/env ybm
# Verifies: SPEC §12/§13, DECISIONS D-FMT-06
# Confirms that the content of an untagged fenced block inside a `##` doc comment is
# exempt from fmt (in-place rewriting by `ybm check`) and is preserved byte-identical
# in its non-canonical form, in contrast to ordinary code outside the fence, which is
# formatted normally in the same check run.
## Performs addition.
##
## ```
## x=1+2
## assert(x==3)
## ```
def add(a: int, b: int): int
    return a + b

result = add(2, 3)
assert(result == 5)
print(f"sum: {result}")
