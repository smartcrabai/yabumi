#!/usr/bin/env ybm

# SPEC 11.2 http verification (real communication with a mock HTTP server).
# SAMPLES_PLAN.md 1.4/1.4.1: gets the base URL from the YABUMI_TEST_HTTP_BASE
# environment variable, and asserts the responses of get/post/put/delete and
# HttpOptions(headers/timeout_ms)+request exactly per section 1.4.1's contract table.
# The effect footprint is {net, env}.
# No uses declaration is needed for a top-level statement (SPEC §8: "top-level implicitly allows every effect").
# In a runtime environment where requires_env=["YABUMI_TEST_HTTP_BASE"] is unset, the
# harness may skip this case (sections 1.3/1.4). Since `ybm check` only performs
# type/effect checking regardless of whether the environment variable is set, .unwrap()'s
# type stays the same and always passes even though env.get may return None.

struct User
    name: str
    age: int

base = env.get("YABUMI_TEST_HTTP_BASE").unwrap()

hello = http.get(base + "/text/hello")?
assert(hello.status == 200, "GET /text/hello should return status 200")
assert(hello.body == "hello", "GET /text/hello body should be 'hello'")

user_resp = http.get(base + "/json/user")?
assert(user_resp.status == 200, "GET /json/user should return status 200")
user: User = json.decode(user_resp.body)?
assert(user.name == "alice", "decoded user.name should be 'alice'")
assert(user.age == 30, "decoded user.age should be 30")

not_found = http.get(base + "/status/404")?
assert(not_found.status == 404, "GET /status/404 should return status 404")

echo_body = "echo-payload"
echoed = http.post(base + "/echo", echo_body)?
assert(echoed.status == 200, "POST /echo should return status 200")
assert(echoed.body == echo_body, "POST /echo should echo back the exact request body")

put_resp = http.put(base + "/put/target", "ignored-body")?
assert(put_resp.status == 200, "PUT /put/target should return status 200")
assert(put_resp.body == "put-ok", "PUT /put/target body should be 'put-ok'")

delete_resp = http.delete(base + "/delete/target")?
assert(delete_resp.status == 200, "DELETE /delete/target should return status 200")
assert(delete_resp.body == "deleted", "DELETE /delete/target body should be 'deleted'")

opts = HttpOptions(headers: {"X-Test": "v"}, timeout_ms: 3000)

headers_resp = http.request("GET", base + "/headers/echo", opts)?
assert(headers_resp.status == 200, "GET /headers/echo should return status 200")
assert(headers_resp.body == "v", "GET /headers/echo should echo back the X-Test header value")

generic_delete = http.request("DELETE", base + "/delete/target", opts)?
assert(generic_delete.body == "deleted", "http.request must honor the method argument")
assert(
    headers_resp.headers.contains_key("content-type"),
    "Response.headers should preserve response headers",
)

slow_resp = http.request("GET", base + "/slow", opts)?
assert(slow_resp.status == 200, "GET /slow should return status 200")
assert(slow_resp.body == "slow-ok", "GET /slow body should be 'slow-ok'")

timeout_opts = HttpOptions(headers: {}, timeout_ms: 100)
timed_out = http.request("GET", base + "/slow", timeout_opts)
assert(timed_out.is_err(), "HttpOptions.timeout_ms must be enforced")

print("http sample done")
