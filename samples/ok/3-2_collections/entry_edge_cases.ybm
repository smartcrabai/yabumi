# SPEC §3.2/§6.2: dict/set preserves insertion order (D-COL-01). Re-inserting after a
# remove appends it at the end, and asserts, via the order retrieved by `.entries()`/`.to_list()`, that the removed position closes up.
# Referenced decisions: D-COL-01 (dict[K,V]/set[T]'s iteration order is always insertion order)

var m: dict[str, int] = {"a": 1, "b": 2, "c": 3}
removed = m.remove("b")
assert(removed.unwrap() == 2)
inserted_old = m.insert("b", 20)
assert(inserted_old.is_none())
entries = m.entries()
assert(entries.len() == 3)
assert(entries[0].0 == "a")
assert(entries[0].1 == 1)
assert(entries[1].0 == "c")
assert(entries[1].1 == 3)
assert(entries[2].0 == "b")
assert(entries[2].1 == 20)

var s: set[int] = {1, 2, 3}
was_removed = s.remove(2)
assert(was_removed)
was_new = s.insert(2)
assert(was_new)
items = s.to_list()
assert(items.len() == 3)
assert(items[0] == 1)
assert(items[1] == 3)
assert(items[2] == 2)
