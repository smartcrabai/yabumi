# Verifies: SPEC §7.2 (`?` operator) / DECISIONS D-ERR-04/D-ERR-05, D-DIAG-02 (E6006)
# Applying `?` in a top-level statement to an Option expression that returns None propagates
# the None, printing an error to stderr and exiting 1 (SPEC §7.2).

def always_none(): Option[int]
    return None

unwrapped = always_none()?
