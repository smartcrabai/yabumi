# Verifies: SPEC §7.4 (no panics) / DECISIONS D-ERR-04 item 6
# Err(e).unwrap() panics (E6007) and terminates immediately.
# The safe version is r.unwrap_or(default) / r.ok(): Option[T] (STDLIB.md §3.1, §14).

def always_fails(): Result[int, Error]
    return Err(Error(kind: "test", message: "boom", cause: None))

unwrapped = always_fails().unwrap()
