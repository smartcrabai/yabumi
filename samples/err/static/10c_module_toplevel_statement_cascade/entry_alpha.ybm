#!/usr/bin/env ybm
# Verifies: cascading-failure pattern (pattern 4) for SPEC §10 "a module holds only declarations; top-level executable statements are forbidden"
# Decisions: DECISIONS.md D-MOD-01 (auto-import covers every file carrying a module directive directly in the same directory)
#
# This file alone is an entry that type-checks and runs correctly (it has zero
# dependency on mod_broken.ybm). The same-directory mod_broken.ybm contains a
# top-level executable statement (print) and becomes E5002; verifies that its
# auto-import causes check on this file to fail as a chain reaction too.

def double(x: int): int
    return x * 2

print(f"alpha: {double(21)}")
