#!/usr/bin/env ybm
# Verifies: cascading-failure pattern (pattern 4) for SPEC §10 "a module holds only declarations; top-level executable statements are forbidden"
# Decisions: DECISIONS.md D-MOD-01 (auto-import covers every file carrying a module directive directly in the same directory)
#
# A second entry, distinct from entry_alpha.ybm, also correct on its own, with zero
# dependency on mod_broken.ybm. Verifies that check on this file also fails as a chain
# reaction because the same-directory mod_broken.ybm is broken with E5002 (confirming
# that "one broken module breaks every entry in the same directory").

def triple(x: int): int
    return x * 3

print(f"beta: {triple(14)}")
